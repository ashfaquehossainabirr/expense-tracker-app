PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/expense-tracker
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Optional: comma-separated emails that should always get admin access on
# registration. The very first account created in a fresh database is also
# made an admin automatically, so this is only needed to add more admins.
ADMIN_EMAILS=
